<style>
  footer {
    height: 8rem;
    background-color: #f7f7f7;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    border-top: 1px solid #dddddd;
  }

  .f-info-socials {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .f-info-socials i {
    font-size: 1.4rem;
    color: #222222;
    transition: color 0.2s ease, transform 0.2s ease;
    cursor: pointer;
  }

  .f-info-socials i:hover {
    color: #ff385c; /* Matches brand color */
    transform: scale(1.1);
  }

  .f-info-brand {
    font-size: 0.95rem;
    color: #222222;
    font-weight: 500;
  }

  .f-info-links {
    margin-top: 0.25rem;
    display: flex;
    gap: 1rem;
  }

  .f-info-links a {
    text-decoration: none;
    color: #717171;
    font-size: 0.85rem;
    transition: color 0.2s;
  }

  .f-info-links a:hover {
    color: #222222;
    text-decoration: underline;
  }

  @media (max-width: 576px) {
    footer {
      height: 10rem;
      padding: 1rem;
    }
  }
</style>

<footer>
  <div class="f-info-socials">
    <a href="https://facebook.com" target="_blank" class="text-dark"><i class="fa-brands fa-square-facebook"></i></a>
    <a href="https://instagram.com" target="_blank" class="text-dark"><i class="fa-brands fa-square-instagram"></i></a>
    <a href="https://linkedin.com" target="_blank" class="text-dark"><i class="fa-brands fa-square-linkedin"></i></a>
  </div>

  <div class="f-info-brand">
    &copy; <%= new Date().getFullYear() %> Wanderlust Private Limited
  </div>

  <div class="f-info-links">
    <a href="/privacy">Privacy Policy</a>
    <a href="/terms">Terms of Service</a>
  </div>
</footer>