    <script>
        // 1. Description Toggle Logic
        document.addEventListener("DOMContentLoaded", () => {
            const desc = document.getElementById("descriptionText");
            const btn = document.getElementById("toggleDescription");
            if (desc.scrollHeight > 80) { btn.style.display = "inline-block"; }
            btn.addEventListener("click", () => {
                if (desc.classList.contains("collapsed")) {
                    desc.classList.remove("collapsed"); desc.classList.add("expanded");
                    btn.innerHTML = 'Show less <i class="fa-solid fa-chevron-up ms-1" style="font-size: 0.8rem;"></i>';
                } else {
                    desc.classList.remove("expanded"); desc.classList.add("collapsed");
                    btn.innerHTML = 'Show more <i class="fa-solid fa-chevron-right ms-1" style="font-size: 0.8rem;"></i>';
                    desc.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                }
            });
        });

        // 2. Airbnb-Style Calendar & Dynamic Price Calculation
        const checkInInput = document.getElementById('checkIn');
        const checkOutInput = document.getElementById('checkOut');
        const priceSummary = document.getElementById('priceSummary');
        const nightsText = document.getElementById('nightsText');
        const subtotalText = document.getElementById('subtotalText');
        const totalPriceText = document.getElementById('totalPriceText');

        function updatePrice() {
            let checkInStr = checkInInput.value;
            let checkOutStr = checkOutInput.value;

            if (checkInStr && checkInStr.includes(' to ')) {
                const parts = checkInStr.split(' to ');
                checkInStr = parts[0];
                checkOutStr = parts[1] || checkOutStr;
            }

            const checkIn = new Date(checkInStr);
            const checkOut = new Date(checkOutStr);

            if (checkInStr && checkOutStr && !isNaN(checkIn) && !isNaN(checkOut) && checkOut > checkIn) {
                const nights = Math.ceil(Math.abs(checkOut - checkIn) / (1000 * 60 * 60 * 24));
                const total = nights * pricePerNight;
                const formattedTotal = total.toLocaleString('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 0 });
                const formattedPrice = pricePerNight.toLocaleString('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 0 });
                nightsText.innerText = `${formattedPrice} x ${nights} night${nights > 1 ? 's' : ''}`;
                subtotalText.innerText = formattedTotal;
                totalPriceText.innerText = formattedTotal;
                priceSummary.classList.remove('d-none');
            } else { priceSummary.classList.add('d-none'); }
        }

        if (checkInInput && checkOutInput) {
            flatpickr(checkInInput, {
                inline: true,
                appendTo: document.getElementById('inline-calendar'),
                minDate: "today",
                altInput: true,
                altFormat: "M j, Y",
                dateFormat: "Y-m-d",
                showMonths: window.innerWidth >= 768 ? 2 : 1, // 2 months on desktop
                plugins: [rangePlugin({ input: "#checkOut" })],
                onChange: function () {
                    updatePrice();
                }
            });
        }

        const bookingForm = document.getElementById('bookingForm');
        if (bookingForm) {
            bookingForm.addEventListener('submit', function (e) {
                if (!checkInInput.value || !checkOutInput.value) {
                    e.preventDefault();
                    e.stopPropagation();
                    alert("Please select both Check-in and Checkout dates before reserving.");
                }
            });
        }
    </script>

    <script src="/js/map.js"></script>

    <script>
        async function toggleShowWishlist(event, listingId, btnElement) {
            event.preventDefault();

            const isLoggedIn = "<%- currentUser ? 'true' : 'false' %>" === "true";
            if (!isLoggedIn) {
                window.location.href = '/login';
                return;
            }

            try {
                const response = await fetch(`/wishlist/${listingId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });
                const data = await response.json();

                const icon = btnElement.querySelector('i');
                const textSpan = btnElement.querySelector('.save-text');

                if (data.action === 'added') {
                    icon.classList.remove('text-muted');
                    icon.classList.add('text-danger');
                    icon.style.setProperty('color', '#ff385c', 'important');
                    textSpan.innerText = 'Saved';
                } else if (data.action === 'removed') {
                    icon.classList.remove('text-danger');
                    icon.classList.add('text-muted');
                    icon.style.removeProperty('color');
                    textSpan.innerText = 'Save';
                }
            } catch (error) {
                console.error('Error toggling wishlist', error);
            }
        }
    </script>