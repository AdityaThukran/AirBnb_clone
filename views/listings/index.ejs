                                                                                                alt="<%= listing.title %>"
                                                                                                loading="lazy">
                                                            </div>

                                                            <div class="card-body">
                                                                <div
                                                                    class="d-flex justify-content-between align-items-start gap-1">
                                                                    <div
                                                                        class="card-location flex-shrink-1 overflow-hidden">
                                                                        <%= listing.location %>, <%= listing.country %>
                                                                    </div>
                                                                    <% if (avgRating) { %>
                                                                        <span class="card-rating flex-shrink-0">
                                                                            <i class="fa-solid fa-star"
                                                                                style="font-size:0.72rem;"></i>
                                                                            <%= avgRating %>
                                                                        </span>
                                                                        <% } %>
                                                                </div>
                                                                <div class="card-title-text">
                                                                    <%= listing.title %>
                                                                </div>
                                                                <div class="card-price"
                                                                    data-price="<%= listing.price %>">
                                                                    <span class="base-price">₹<%=
                                                                            listing.price.toLocaleString("en-IN") %>
                                                                    </span><span class="per-night"> /
                                                                        night</span>
                                                                    <div class="tax-price"
                                                                        style="display:none; font-size:0.82rem; color:#717171; font-weight:400; margin-top:2px;">
                                                                        ₹<span class="tax-val"></span> / night <span
                                                                            style="color:#22c55e; font-weight:600;">incl.
                                                                            18% GST</span>
