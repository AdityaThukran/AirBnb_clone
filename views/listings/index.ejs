                <script>
                    document.addEventListener('DOMContentLoaded', function () {
                        const STORAGE_KEY = 'wanderlust_promo_seen';
                        const overlay = document.getElementById('promoModal');
                        const closeBtn = document.getElementById('promoCloseBtn');
                        const dismissBtn = document.getElementById('promoDismissBtn');
                        const ctaBtn = document.getElementById('promoCTA');
                        const copyBtn = document.getElementById('promoCopyBtn');
                        const promoCode = document.getElementById('promoCode');

                        if (!overlay) return; // safety guard

                        function closeModal() {
                            overlay.style.opacity = '0';
                            overlay.style.pointerEvents = 'none';
                            setTimeout(function () { overlay.style.display = 'none'; }, 400);
                            localStorage.setItem(STORAGE_KEY, '1');
                        }

                        function openModal() {
                            overlay.style.display = 'flex';
                            // Force reflow so transition plays
                            overlay.getBoundingClientRect();
                            overlay.style.opacity = '1';
                            overlay.style.pointerEvents = 'auto';
                        }

                        // Show only on first visit
                        if (!localStorage.getItem(STORAGE_KEY)) {
                            setTimeout(openModal, 1000);

                            // Only enable backdrop-click after the animation settles
                            setTimeout(function () {
                                overlay.addEventListener('click', function (e) {
                                    if (e.target === overlay) closeModal();
                                });
                            }, 2500);
                        }

                        closeBtn.addEventListener('click', closeModal);
                        dismissBtn.addEventListener('click', closeModal);
                        ctaBtn.addEventListener('click', closeModal);

                        // Copy code button
                        copyBtn.addEventListener('click', function () {
                            navigator.clipboard.writeText(promoCode.textContent.trim()).then(function () {
                                copyBtn.innerHTML = '<i class="fa-solid fa-check"></i>';
                                copyBtn.style.background = '#22c55e';
                                setTimeout(function () {
                                    copyBtn.innerHTML = '<i class="fa-regular fa-copy"></i>';
                                    copyBtn.style.background = '#222';
                                }, 2000);
                            });
                        });

                        // ESC key closes
                        document.addEventListener('keydown', function (e) {
                            if (e.key === 'Escape') closeModal();
                        });
                    });
                </script>

                <script>
                    // ── Tax Toggle ──
                    document.addEventListener('DOMContentLoaded', function () {
                        const toggle = document.getElementById('switchCheckDefault');
                        if (!toggle) return;

                        const TAX_RATE = 0.18;

                        function applyTax(showTax) {
                            document.querySelectorAll('.card-price[data-price]').forEach(function (el) {
                                const base = parseFloat(el.dataset.price);
                                const taxInclusive = Math.round(base * (1 + TAX_RATE));

                                const baseEl = el.querySelector('.base-price');
                                const taxDiv = el.querySelector('.tax-price');
                                const taxVal = el.querySelector('.tax-val');

                                if (!baseEl || !taxDiv || !taxVal) return;

                                if (showTax) {
                                    // Keep original price as-is, show inflated price below it
                                    taxVal.textContent = taxInclusive.toLocaleString('en-IN');
                                    taxDiv.style.display = 'block';
                                } else {
                                    taxDiv.style.display = 'none';
                                }
                            });

                            // Persist preference
                            localStorage.setItem('wanderlust_show_taxes', showTax ? '1' : '0');
                        }

                        // Restore preference from last session
                        const saved = localStorage.getItem('wanderlust_show_taxes');
                        if (saved === '1') {
                            toggle.checked = true;
                            applyTax(true);
                        }

                        toggle.addEventListener('change', function () {
                            applyTax(this.checked);
                        });
                    });
                </script>