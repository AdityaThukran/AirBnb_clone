                <!-- Back to top button -->
                <button id="backToTop" title="Back to top" aria-label="Back to top">
                    <i class="fa-solid fa-arrow-up"></i>
                </button>

                <script>
                    /* ── Blur-up lazy loading ── */
                    document.addEventListener('DOMContentLoaded', () => {
                        const lazyImgs = document.querySelectorAll('.lazy-img');
                        const obs = new IntersectionObserver((entries) => {
                            entries.forEach(entry => {
                                if (entry.isIntersecting) {
                                    const img = entry.target;
                                    const hqSrc = img.dataset.src;
                                    if (hqSrc && img.src !== hqSrc) {
                                        const hi = new Image();
                                        hi.onload = () => { img.src = hqSrc; img.classList.add('loaded'); };
                                        hi.src = hqSrc;
                                    } else {
                                        img.classList.add('loaded');
                                    }
                                    obs.unobserve(img);
                                }
                            });
                        }, { rootMargin: '200px' });
                        lazyImgs.forEach(img => obs.observe(img));
                    });

                    /* ── Filter bar shadow on scroll ── */
                    const filtersBar = document.getElementById('filters');
                    window.addEventListener('scroll', () => {
                        if (window.scrollY > 10) {
                            filtersBar.classList.add('shadowed');
                        } else {
                            filtersBar.classList.remove('shadowed');
                        }
                    }, { passive: true });

                    /* ── Back to top ── */
                    const backToTopBtn = document.getElementById('backToTop');
                    window.addEventListener('scroll', () => {
                        if (window.scrollY > 400) {
                            backToTopBtn.classList.add('visible');
                        } else {
                            backToTopBtn.classList.remove('visible');
                        }
                    }, { passive: true });
                    backToTopBtn.addEventListener('click', () => {
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                    });

                    /* ── Tax toggle ── */
                    const taxToggle = document.getElementById('switchCheckDefault');
                    if (taxToggle) {
                        taxToggle.addEventListener('change', function () {
                            document.querySelectorAll('#tax-info').forEach(el => {
                                el.style.display = this.checked ? 'inline' : 'none';
                            });
                        });
                    }

                    /* ── Wishlist toggle ── */
                    async function toggleWishlist(event, listingId, element) {
                        event.preventDefault();
                        event.stopPropagation();

                        const isLoggedIn = "<%= currentUser ? 'true' : 'false' %>" === "true";

                        if (!isLoggedIn) {
                            window.location.href = '/login';
                            return;
                        }

                        try {
                            const res = await fetch(`/wishlist/${listingId}`, {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' }
                            });
                            const data = await res.json();

                            // Animate the heart
                            element.style.transform = 'scale(1.4)';
                            setTimeout(() => element.style.transform = '', 200);

                            if (data.action === 'added') {
                                element.classList.add('wished-heart');
                            } else {
                                element.classList.remove('wished-heart');
                            }
                        } catch (err) {
                            console.error('Wishlist error:', err);
                        }
                    }
                </script>

