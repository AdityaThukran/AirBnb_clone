<% layout('layouts/boilerplate') %>

    <style>
        .chat-container {
            max-width: 800px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            height: calc(100vh - 100px);
        }

        .chat-header {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem 1.5rem;
            border-bottom: 1px solid #ebebeb;
            background-color: white;
            position: sticky;
            top: 70px;
            z-index: 10;
        }

        .chat-header a {
            color: #222;
            text-decoration: none;
            font-size: 1.2rem;
        }

        .chat-header-avatar {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            object-fit: cover;
        }

        .chat-header-info strong {
            display: block;
            font-weight: 700;
            font-size: 1rem;
        }

        .chat-header-info span {
            font-size: 0.85rem;
            color: #717171;
        }

        .chat-listing-card {
            margin: 1rem 1.5rem;
            background: #f7f7f7;
            border-radius: 12px;
            padding: 1rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            border: 1px solid #ebebeb;
        }

        .chat-listing-card img {
            width: 64px;
            height: 64px;
            border-radius: 8px;
            object-fit: cover;
        }

        .chat-listing-card .listing-info strong {
            font-weight: 700;
            font-size: 0.95rem;
            display: block;
        }

        .chat-listing-card .listing-info a {
            font-size: 0.85rem;
            color: #ff385c;
            text-decoration: none;
            font-weight: 600;
        }

        .messages-area {
            flex: 1;
            overflow-y: auto;
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .message-bubble-wrap {
            display: flex;
            align-items: flex-end;
            gap: 0.5rem;
        }

        .message-bubble-wrap.sent {
            flex-direction: row-reverse;
        }

        .message-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            object-fit: cover;
            flex-shrink: 0;
        }

        .message-bubble {
            max-width: 65%;
            padding: 0.75rem 1rem;
            border-radius: 20px;
            font-size: 0.95rem;
            line-height: 1.4;
            word-break: break-word;
        }

        .message-bubble.received {
            background-color: #f0f0f0;
            color: #222;
            border-bottom-left-radius: 4px;
        }

        .message-bubble.sent {
            background-color: #ff385c;
            color: white;
            border-bottom-right-radius: 4px;
        }

        .message-time {
            font-size: 0.72rem;
            color: #b0b0b0;
            margin-top: 0.2rem;
            text-align: right;
        }

        .message-bubble-wrap.received .message-time {
            text-align: left;
        }

        .chat-input-area {
            padding: 1rem 1.5rem;
            border-top: 1px solid #ebebeb;
            background-color: white;
            position: sticky;
            bottom: 0;
        }

        .chat-input-form {
            display: flex;
            gap: 0.75rem;
            align-items: flex-end;
        }

        .chat-input-form textarea {
            flex: 1;
            border: 1.5px solid #dddddd;
            border-radius: 24px;
            padding: 0.7rem 1rem;
            font-size: 0.95rem;
            resize: none;
            outline: none;
            transition: border-color 0.2s;
            min-height: 48px;
            max-height: 120px;
            line-height: 1.4;
        }

        .chat-input-form textarea:focus {
            border-color: #222;
        }

        .send-btn {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background-color: #ff385c;
            color: white;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: background-color 0.2s, transform 0.1s;
            flex-shrink: 0;
        }

        .send-btn:hover {
            background-color: #e31c5f;
            transform: scale(1.05);
        }

        .date-separator {
            display: flex;
            align-items: center;
            gap: 1rem;
            color: #b0b0b0;
            font-size: 0.78rem;
            font-weight: 500;
        }

        .date-separator::before,
        .date-separator::after {
            content: '';
            flex: 1;
            height: 1px;
            background: #ebebeb;
        }
    </style>

    <div class="chat-container mt-3">
        <div class="chat-header">
            <a href="/messages"><i class="fa-solid fa-arrow-left"></i></a>
            <img src="<%= otherUser ? otherUser.avatarUrl : 'https://a0.muscache.com/defaults/user_pic-225x225.png?v=3' %>"
                alt="avatar" class="chat-header-avatar">
            <div class="chat-header-info">
                <strong>
                    <%= otherUser ? otherUser.username : 'User' %>
                </strong>
                <span>Wanderlust Host</span>
            </div>
        </div>

        <% if (conversation.listing) { %>
            <div class="chat-listing-card">
                <% if (conversation.listing.image && conversation.listing.image.length> 0) { %>
                    <img src="<%= conversation.listing.image[0].url %>" alt="Listing">
                    <% } %>
                        <div class="listing-info">
                            <strong>
                                <%= conversation.listing.title %>
                            </strong>
                            <a href="/listings/<%= conversation.listing._id %>">View Listing →</a>
                        </div>
            </div>
            <% } %>

                <div class="messages-area" id="messagesArea">
                    <% let lastDate=null; %>
                        <% for (let msg of conversation.messages) { const
                            isSent=msg.sender.toString()===currentUser._id.toString(); const msgDate=new
                            Date(msg.createdAt).toLocaleDateString('en-IN', { day: 'numeric' , month: 'long' ,
                            year: 'numeric' }); const msgTime=new Date(msg.createdAt).toLocaleTimeString('en-IN', {
                            hour: '2-digit' , minute: '2-digit' }); const senderUser=conversation.participants.find(p=>
                            p._id.toString() === msg.sender.toString());
                            %>
                            <% if (msgDate !==lastDate) { %>
                                <div class="date-separator">
                                    <%= msgDate %>
                                </div>
                                <% lastDate=msgDate; %>
                                    <% } %>

                                        <div class="message-bubble-wrap <%= isSent ? 'sent' : 'received' %>">
                                            <% if (!isSent) { %>
                                                <img src="<%= senderUser ? senderUser.avatarUrl : 'https://a0.muscache.com/defaults/user_pic-225x225.png?v=3' %>"
                                                    alt="avatar" class="message-avatar">
                                                <% } %>
                                                    <div>
                                                        <div class="message-bubble <%= isSent ? 'sent' : 'received' %>">
                                                            <%= msg.content %>
                                                        </div>
                                                        <div class="message-time">
                                                            <%= msgTime %>
                                                        </div>
                                                    </div>
                                        </div>
                                        <% } %>
                </div>

                <div class="chat-input-area">
                    <form action="/messages/<%= conversation._id %>/reply" method="POST" class="chat-input-form"
                        id="replyForm">
                        <textarea name="body" id="messageInput" placeholder="Type a message..." rows="1"
                            required></textarea>
                        <button type="submit" class="send-btn">
                            <i class="fa-solid fa-paper-plane"></i>
                        </button>
                    </form>
                </div>
    </div>

    <script>
        // Auto-scroll to bottom of messages
        const messagesArea = document.getElementById('messagesArea');
        if (messagesArea) {
            messagesArea.scrollTop = messagesArea.scrollHeight;
        }

        // Auto-expand textarea
        const messageInput = document.getElementById('messageInput');
        if (messageInput) {
            messageInput.addEventListener('input', function () {
                this.style.height = 'auto';
                this.style.height = Math.min(this.scrollHeight, 120) + 'px';
            });

            // Submit on Enter (but not Shift+Enter)
            messageInput.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    if (this.value.trim()) {
                        document.getElementById('replyForm').submit();
                    }
                }
            });
        }
    </script>