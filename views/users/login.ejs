<% layout("/layouts/boilerplate") %>

<div class="auth-container">
    <div class="auth-card">
        <div class="text-center mb-4">
            <i class="fa-solid fa-compass auth-brand"></i>
            <h2 class="fw-bold">Welcome Back</h2>
            <p class="text-muted">Log in to your Wanderlust account</p>
        </div>

        <form action="/login" method="POST" class="needs-validation" novalidate>
            <div class="mb-3">
                <label for="username" class="form-label fw-bold">Username</label>
                <input 
                    name="username" 
                    placeholder="Enter your username" 
                    type="text" 
                    class="form-control auth-input" 
                    id="username" 
                    required>
                <div class="invalid-feedback">Please enter your username.</div>
            </div>

            <div class="mb-3">
                <label for="password" class="form-label fw-bold">Password</label>
                <input 
                    name="password" 
                    placeholder="Enter your password" 
                    type="password" 
                    class="form-control auth-input" 
                    id="password" 
                    required>
                <div class="invalid-feedback">Please enter your password.</div>
            </div>

            <button class="btn btn-dark w-100 auth-btn mt-2">Login</button>
        </form>

        <hr class="my-4">
        <p class="text-center mb-0">
            Don't have an account? <a href="/signup" class="auth-link">Sign up</a>
        </p>
    </div>
</div>